# Unity Build URL (Cloudflare R2 bucket)
VITE_UNITY_BUILD_URL=https://your-r2-bucket.r2.dev

# Backend API — 0G decentralized save/load backend
VITE_API_URL=https://dogescape.onrender.com

# Blockchain Network
VITE_CHAIN_ID=1
VITE_RPC_URL=https://mainnet.infura.io/v3/YOUR_INFURA_KEY

# DogeOS SDK
VITE_DOGEOS_CLIENT_ID=YOUR_DOGEOS_CLIENT_ID

# Smart Contract Addresses
VITE_BOAT_CONTRACT=0x...
VITE_COMPANION_CONTRACT=0x...
VITE_GUN_CONTRACT=0x...

# Optional: Analytics
VITE_GA_ID=G-XXXXXXXXXX
